{
	"name": "@dakiya/cli",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"bin": {
		"dakiya": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"hello": "pnpm build && node dist/cli.js hello",
		"dakiya": "pnpm build && node dist/cli.js",
		"init": "pnpm build && node dist/cli.js init",
		"list": "pnpm build && node dist/cli.js list",
		"run": "pnpm build && node dist/cli.js run",
		"serve": "pnpm build && node dist/cli.js serve",
		"link:global": "pnpm build && pnpm link --global",
		"unlink:global": "pnpm unlink --global"
	},
	"dependencies": {
		"@dakiya/domain": "workspace:*",
		"@dakiya/format": "workspace:*",
		"@dakiya/services": "workspace:*",
		"vite": "^7.0.4"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "~5.8.3"
	}
}
