{
	"name": "dakiya",
	"private": true,
	"version": "0.0.0",
	"description": "Local-first API toolkit — CLI + web dashboard",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"bin": {
		"dakiya": "./dist/cli/cli.js"
	},
	"scripts": {
		"dev:web": "vite",
		"build:web": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"build:cli": "esbuild src/cli/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli/cli.js && node -e \"require('node:fs').chmodSync('dist/cli/cli.js', 0o755)\"",
		"dakiya": "pnpm build:cli && node dist/cli/cli.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/view": "^6.43.9",
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/react": "^1.1.10",
		"@tanstack/react-query": "^5.101.4",
		"@uiw/codemirror-theme-github": "^4.25.11",
		"@uiw/react-codemirror": "^4.25.11",
		"esbuild": "^0.28.1",
		"hono": "^4.12.31",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"yaml": "^2.9.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^22.10.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"vite-plugin-pwa": "^1.3.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.0.5"
	}
}
