{
	"name": "dakiya",
	"version": "0.1.0",
	"description": "Local-first API toolkit — CLI + web dashboard",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"bin": {
		"dakiya": "./dist/cli/cli.js"
	},
	"scripts": {
		"dev:web": "vite",
		"build": "pnpm build:web && pnpm build:cli",
		"build:web": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"build:cli": "esbuild src/cli/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli/cli.js && node -e \"require('node:fs').chmodSync('dist/cli/cli.js', 0o755)\"",
		"dakiya": "pnpm build && node dist/cli/cli.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/view": "^6.43.9",
		"@hono/node-server": "^2.1.1",
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/react": "^1.1.10",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tanstack/react-query": "^5.101.4",
		"@uiw/codemirror-theme-github": "^4.25.11",
		"@uiw/react-codemirror": "^4.25.11",
		"cac": "^7.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"esbuild": "^0.28.1",
		"hono": "^4.12.31",
		"hugeicons-react": "^0.4.0",
		"lucide-react": "^1.37.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^2.1.9",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"yaml": "^2.9.0",
		"zod": "^3.24.2",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^22.10.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"autoprefixer": "^10.5.4",
		"postcss": "^8.5.26",
		"tailwindcss": "^3.4.19",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"vite-plugin-pwa": "^1.3.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.0.5"
	},
	"author": "Prashant",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Prashant4900/Dakiya.git"
	},
	"homepage": "https://github.com/Prashant4900/Dakiya#readme",
	"bugs": {
		"url": "https://github.com/Prashant4900/Dakiya/issues"
	},
	"keywords": [
		"api",
		"http-client",
		"postman",
		"rest",
		"graphql",
		"developer-tools",
		"cli",
		"yaml"
	],
	"files": [
		"dist"
	]
}
