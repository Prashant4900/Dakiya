{
	"name": "dakiya",
	"private": true,
	"version": "0.0.0",
	"description": "Local-first API toolkit — CLI + web dashboard (desktop later)",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"build": "pnpm -r run build",
		"dev:web": "pnpm --filter @dakiya/web dev",
		"dev:example": "pnpm --filter @example/server dev",
		"hello": "pnpm --filter @dakiya/cli hello",
		"dakiya": "pnpm --filter @dakiya/cli dakiya",
		"dakiya:init": "pnpm --filter @dakiya/cli run init",
		"dakiya:list": "pnpm --filter @dakiya/cli run list",
		"dakiya:serve": "pnpm --filter @dakiya/cli run serve",
		"link:cli": "pnpm --filter @dakiya/domain build && pnpm --filter @dakiya/format build && pnpm --filter @dakiya/services build && pnpm --filter @dakiya/cli run link:global",
		"unlink:cli": "pnpm --filter @dakiya/cli run unlink:global",
		"typecheck": "pnpm -r run typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "pnpm -r run test"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5"
	}
}
